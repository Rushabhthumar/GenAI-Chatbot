# Copy this file to .env and fill in your values. NEVER commit .env (it holds secrets).

# "local" = 100% free on your PC (Ollama + pypdf + data/local_store.json) - no keys needed below.
# "azure" = Azure OpenAI + Document Intelligence + Cosmos DB - fill in the Azure section.
AI_PROVIDER=local

# Local mode (Ollama must be running: `ollama list`; models: `ollama pull qwen2.5:3b` and `ollama pull nomic-embed-text`)
OLLAMA_CHAT_MODEL=qwen2.5:3b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Azure OpenAI (Azure AI Foundry -> your resource -> Keys and Endpoint; deployment names from "Deployments")
AZURE_OPENAI_ENDPOINT=https://<your-openai>.openai.azure.com/
AZURE_OPENAI_API_KEY=<key>
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Azure AI Document Intelligence
DOCINTEL_ENDPOINT=https://<your-docintel>.cognitiveservices.azure.com/
DOCINTEL_KEY=<key>

# Azure Cosmos DB for NoSQL (enable "Vector Search for NoSQL API" under the account's Features first!)
COSMOS_ENDPOINT=https://<your-cosmos>.documents.azure.com:443/
COSMOS_KEY=<key>
COSMOS_DATABASE=ragdb
COSMOS_CONTAINER=chunks

# OPTIONAL - LangSmith tracing: see every chain/retriever/agent step (inputs, outputs, tokens, time) in a web UI.
# Free account at smith.langchain.com. LangChain picks these up automatically - no code change needed.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=<key>
# LANGSMITH_PROJECT=azure-rag-chatbot
